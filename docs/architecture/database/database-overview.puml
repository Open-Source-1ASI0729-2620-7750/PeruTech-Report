@startuml Preciazo_Database_Overview

title Preciazo - Database Overview

hide circle
skinparam linetype ortho
skinparam shadowing false

entity users {
    * id : BIGINT <<PK>>
    --
    email : VARCHAR <<UQ>>
    status : VARCHAR
}

entity roles {
    * id : BIGINT <<PK>>
    --
    name : VARCHAR <<UQ>>
}

entity permissions {
    * id : BIGINT <<PK>>
    --
    resource : VARCHAR
    action : VARCHAR
}

entity user_roles {
    * user_id : BIGINT <<PK, FK>>
    * role_id : BIGINT <<PK, FK>>
}

entity role_permissions {
    * role_id : BIGINT <<PK, FK>>
    * permission_id : BIGINT <<PK, FK>>
}

entity auth_sessions {
    * id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK>>
    issued_at : TIMESTAMP
    expires_at : TIMESTAMP
    revoked : BOOLEAN
}

entity merchant_profiles {
    * id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK>>
    tax_id : VARCHAR <<UQ>>
    verification_status : VARCHAR
}

entity retail_stores {
    * id : BIGINT <<PK>>
    --
    merchant_profile_id : BIGINT <<FK>>
    name : VARCHAR
    address : VARCHAR
    latitude : DECIMAL
    longitude : DECIMAL
    trust_score : DECIMAL
}

entity products {
    * id : BIGINT <<PK>>
    --
    name : VARCHAR
    brand : VARCHAR
    category : VARCHAR
    unit : VARCHAR
}

entity inventory_items {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    product_id : BIGINT <<FK>>
    stock : DECIMAL
    unit_price : DECIMAL
    stock_status : VARCHAR
}

entity catalog_entries {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    product_id : BIGINT <<FK>>
    unit_price : DECIMAL
    stock_status : VARCHAR
    updated_at : TIMESTAMP
}

entity price_snapshots {
    * id : BIGINT <<PK>>
    --
    catalog_entry_id : BIGINT <<FK>>
    unit_price : DECIMAL
    captured_at : TIMESTAMP
}

entity shopping_lists {
    * id : BIGINT <<PK>>
    --
    owner_id : BIGINT <<FK>>
    name : VARCHAR
    status : VARCHAR
    created_at : TIMESTAMP
}

entity shopping_list_members {
    * shopping_list_id : BIGINT <<PK, FK>>
    * user_id : BIGINT <<PK, FK>>
    --
    member_role : VARCHAR
}

entity shopping_list_items {
    * id : BIGINT <<PK>>
    --
    shopping_list_id : BIGINT <<FK>>
    product_id : BIGINT <<FK>>
    quantity : DECIMAL
    purchased : BOOLEAN
    estimated_unit_price : DECIMAL
}

entity purchase_budgets {
    * id : BIGINT <<PK>>
    --
    shopping_list_id : BIGINT <<FK>>
    amount : DECIMAL
    status : VARCHAR
    currency : VARCHAR
}

entity routes {
    * id : BIGINT <<PK>>
    --
    shopping_list_id : BIGINT <<FK>>
    distance : DECIMAL
    estimated_duration : INTEGER
    net_savings : DECIMAL
    transit_cost : DECIMAL
    status : VARCHAR
}

entity route_stops {
    * id : BIGINT <<PK>>
    --
    route_id : BIGINT <<FK>>
    store_id : BIGINT <<FK>>
    sequence : INTEGER
    estimated_arrival : TIMESTAMP
}

entity promotions {
    * id : BIGINT <<PK>>
    --
    inventory_item_id : BIGINT <<FK>>
    starts_at : TIMESTAMP
    ends_at : TIMESTAMP
    description : VARCHAR
}

entity price_observations {
    * id : BIGINT <<PK>>
    --
    catalog_entry_id : BIGINT <<FK>>
    discrepancy_id : BIGINT <<FK>>
    observer_id : BIGINT <<FK>>
    observed_price : DECIMAL
    observed_at : TIMESTAMP
    source : VARCHAR
}

entity price_discrepancies {
    * id : BIGINT <<PK>>
    --
    catalog_entry_id : BIGINT <<FK>>
    reporter_id : BIGINT <<FK>>
    expected_price : DECIMAL
    observed_price : DECIMAL
    status : VARCHAR
}

entity verification_confirmations {
    * id : BIGINT <<PK>>
    --
    discrepancy_id : BIGINT <<FK>>
    confirmer_id : BIGINT <<FK>>
    created_at : TIMESTAMP
}

entity trust_profiles {
    * id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK, UQ>>
    score : DECIMAL
    level : VARCHAR
}

entity analytics_events {
    * id : BIGINT <<PK>>
    --
    subject_id : BIGINT <<REF>>
    event_type : VARCHAR
    occurred_at : TIMESTAMP
    metadata : JSON
}

entity merchant_metrics {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    period_from : TIMESTAMP
    period_to : TIMESTAMP
    monthly_traffic : INTEGER
    lost_sales : DECIMAL
    engagement_score : DECIMAL
}

entity merchant_reports {
    * id : BIGINT <<PK>>
    --
    store_id : BIGINT <<FK>>
    report_type : VARCHAR
    period_from : TIMESTAMP
    period_to : TIMESTAMP
    generated_at : TIMESTAMP
}

users ||--o{ user_roles
roles ||--o{ user_roles
roles ||--o{ role_permissions
permissions ||--o{ role_permissions
users ||--o{ auth_sessions
users ||--o| merchant_profiles
merchant_profiles ||--o{ retail_stores
retail_stores ||--o{ inventory_items
products ||--o{ inventory_items
retail_stores ||--o{ catalog_entries
products ||--o{ catalog_entries
catalog_entries ||--o{ price_snapshots
users ||--o{ shopping_lists
shopping_lists ||--o{ shopping_list_members
users ||--o{ shopping_list_members
shopping_lists ||--o{ shopping_list_items
products ||--o{ shopping_list_items
shopping_lists ||--o{ purchase_budgets
shopping_lists ||--o{ routes
routes ||--o{ route_stops
retail_stores ||--o{ route_stops
inventory_items ||--o{ promotions
catalog_entries ||--o{ price_observations
price_discrepancies ||--o{ price_observations
users ||--o{ price_observations
catalog_entries ||--o{ price_discrepancies
users ||--o{ price_discrepancies
price_discrepancies ||--o{ verification_confirmations
users ||--o{ verification_confirmations
users ||--o| trust_profiles
retail_stores ||--o{ merchant_metrics
retail_stores ||--o{ merchant_reports

note right of merchant_profiles
  One merchant profile per user.
  UNIQUE(user_id)
end note

note right of permissions
  UNIQUE(resource, action)
end note

note right of catalog_entries
  UNIQUE(store_id, product_id)
end note

note right of shopping_list_members
  user_id belongs to
  Identity and Access.
end note

note right of inventory_items
  product_id belongs to
  Catalog and Pricing.
end note

note right of purchase_budgets
  At most one ACTIVE budget
  per shopping list.
end note

note right of route_stops
  UNIQUE(route_id, sequence)
end note

note right of analytics_events
  subject_id is a polymorphic reference
  to an event subject in another context.
end note

@enduml
