@startuml Preciazo_C4_Components_Frontend

!include <C4/C4_Component>

LAYOUT_LEFT_RIGHT()

title Preciazo - Single-Page Application (SPA) Component Diagram

Person(buyer, "Buyer", "Uses shopping, price comparison, route and verification features.")
Person(merchantPerson, "Merchant", "Uses store, catalog, inventory, offer and analytics features.")
Container(api, "Preciazo REST API", "Java, Spring Boot, Spring Data JPA", "Provides RESTful application services consumed by the SPA.")

Container_Boundary(web, "Single-Page Application (SPA)") {
    Component(router, "Router / Guards", "Angular Router", "Resolves routes and protects role-specific navigation.")
    Component(shared, "Shared UI", "Angular, TypeScript, Angular Material", "Provides reusable layout, forms, tables, validation and feedback components.")
    Component(identity, "Identity and Access UI", "Angular, TypeScript", "Supports sign-in, session state, role context and access-related flows.")
    Component(shopping, "Shopping Planning UI", "Angular, TypeScript", "Supports shared shopping lists, budgets and purchase progress.")
    Component(catalog, "Catalog and Pricing UI", "Angular, TypeScript", "Searches products, compares unit prices and displays availability.")
    Component(route, "Route Planning UI", "Angular, TypeScript", "Configures multi-stop routes and presents estimated savings and travel information.")
    Component(merchantManagement, "Merchant Management UI", "Angular, TypeScript", "Manages stores, catalog, inventory and offers.")
    Component(verification, "Community Price Verification UI", "Angular, TypeScript", "Reports price discrepancies and shows verification status.")
    Component(analytics, "Analytics and Engagement UI", "Angular, TypeScript", "Presents merchant traffic, lost sales and engagement metrics.")
    Component(apiServices, "API/Application Services", "Angular, TypeScript, HttpClient", "Encapsulates API calls, DTO mapping, loading state and error handling for feature modules.")
}

Rel(buyer, identity, "Signs in", "HTTPS")
Rel(buyer, shopping, "Plans purchases", "HTTPS")
Rel(buyer, catalog, "Compares prices", "HTTPS")
Rel(buyer, route, "Plans routes", "HTTPS")
Rel(buyer, verification, "Reports prices", "HTTPS")
Rel(merchantPerson, identity, "Signs in", "HTTPS")
Rel(merchantPerson, merchantManagement, "Manages stores and offers", "HTTPS")
Rel(merchantPerson, analytics, "Reviews metrics", "HTTPS")
Rel(router, identity, "Routes and guards")
Rel(router, shopping, "Routes and guards")
Rel(router, catalog, "Routes and guards")
Rel(router, route, "Routes and guards")
Rel(router, merchantManagement, "Routes and guards")
Rel(router, verification, "Routes and guards")
Rel(router, analytics, "Routes and guards")
Rel(identity, shared, "Uses shared UI components")
Rel(shopping, shared, "Uses shared UI components")
Rel(catalog, shared, "Uses shared UI components")
Rel(route, shared, "Uses shared UI components")
Rel(merchantManagement, shared, "Uses shared UI components")
Rel(verification, shared, "Uses shared UI components")
Rel(analytics, shared, "Uses shared UI components")
Rel(identity, apiServices, "Calls")
Rel(shopping, apiServices, "Calls")
Rel(catalog, apiServices, "Calls")
Rel(route, apiServices, "Calls")
Rel(merchantManagement, apiServices, "Calls")
Rel(verification, apiServices, "Calls")
Rel(analytics, apiServices, "Calls")
Rel(apiServices, api, "Invokes REST endpoints", "HTTPS / JSON")

SHOW_LEGEND()

@enduml
