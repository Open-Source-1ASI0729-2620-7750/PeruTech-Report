@startuml Preciazo_Analytics_Engagement_Classes

title Preciazo - Analytics and Engagement Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

interface AnalyticsEventStore {
    +append(event: MetricEvent): void
    +findBetween(period: ReportingPeriod): List<MetricEvent>
}

interface MetricsCalculator {
    +calculate(events: List<MetricEvent>): MerchantMetrics
}

class AnalyticsService {
    +record(event: MetricEvent): void
    +generateMetrics(period: ReportingPeriod): MerchantMetrics
    +generateReport(period: ReportingPeriod, type: ReportType): MerchantReport
}

class MetricEvent {
    -id: UUID
    -type: MetricEventType
    -occurredAt: DateTime
    -subjectId: UUID
    +isWithin(period: ReportingPeriod): Boolean
}

class MerchantMetrics {
    -period: ReportingPeriod
    -monthlyTraffic: Integer
    -lostSales: Money
    -engagementScore: Decimal
    +recordVisit(): void
    +recordLostSale(value: Money): void
    +calculateEngagement(): Decimal
}

class MerchantReport {
    -id: UUID
    -type: ReportType
    -generatedAt: DateTime
    +summarize(metrics: MerchantMetrics): String
    +isFor(type: ReportType): Boolean
}

class ReportingPeriod <<Value Object>> {
    -from: DateTime {readOnly}
    -to: DateTime {readOnly}
    +contains(moment: DateTime): Boolean
}

class Money <<Value Object>> {
    -amount: Decimal {readOnly}
    -currency: String {readOnly}
    +add(other: Money): Money
    +subtract(other: Money): Money
    +multiply(factor: Decimal): Money
    +isLessThan(other: Money): Boolean
    +isGreaterThan(other: Money): Boolean
    +isDifferentFrom(other: Money): Boolean
    +isPositive(): Boolean
}

note right of Money
  Immutable; equality by amount and currency.
  Arithmetic and comparisons require the same currency.
  Operations return new values.
end note

enum MetricEventType {
    STORE_VISIT
    PRODUCT_VIEW
    PRICE_COMPARISON
    LOST_SALE
    OFFER_INTERACTION
}

enum ReportType {
    MONTHLY_TRAFFIC
    LOST_SALES
    ENGAGEMENT
}

AnalyticsService ..> AnalyticsEventStore : persists events
AnalyticsService ..> MetricsCalculator : calculates metrics
MerchantMetrics "1" --> "1" ReportingPeriod : covers
MerchantMetrics "1" --> "1" Money : totals lost sales
MerchantReport "*" --> "1" MerchantMetrics : summarizes
MetricEvent ..> ReportingPeriod : checks occurrence within

note right of ReportingPeriod
  Immutable; from <= to.
  Equality by both endpoints.
end note

@enduml
