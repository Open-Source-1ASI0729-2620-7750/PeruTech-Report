@startuml Preciazo_Identity_Access_Classes

title Preciazo - Identity and Access Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

interface IdentityRepository {
    +findByEmail(email: EmailAddress): User
    +save(user: User): void
}

interface AccessPolicy {
    +allows(user: User, permission: Permission): Boolean
}

class IdentityService {
    +authenticate(email: EmailAddress, credential: String): AuthSession
    +revoke(session: AuthSession): void
    +assignRole(user: User, role: Role): void
}

class User {
    -id: Long
    -email: EmailAddress
    -status: AccountStatus
    +authenticate(credential: String): AuthSession
    +assignRole(role: Role): void
    +deactivate(): void
    +can(permission: Permission): Boolean
}

class AuthSession {
    -id: Long
    -issuedAt: DateTime
    -expiresAt: DateTime
    -revoked: Boolean
    +isActiveAt(moment: DateTime): Boolean
    +revoke(): void
}

class Role {
    -name: RoleName
    +grant(permission: Permission): void
    +allows(permission: Permission): Boolean
}

class Permission {
    -resource: String
    -action: String
    +matches(resource: String, action: String): Boolean
}

enum AccountStatus {
    ACTIVE
    SUSPENDED
    DEACTIVATED
}

enum RoleName {
    BUYER
    MERCHANT
}

IdentityService ..> IdentityRepository : loads and saves
IdentityService ..> AccessPolicy : authorizes
User "1" *-- "0..*" AuthSession : owns
User "1" o-- "1..*" Role : has
Role "1" o-- "1..*" Permission : grants
IdentityService ..> User : authenticates

class EmailAddress <<Value Object>> {
    -value: String {readOnly}
    +equals(other: EmailAddress): Boolean
}

note right of EmailAddress
  Immutable; nonblank address with valid email syntax.
  Equality by stored value.
end note

User "1" --> "1" EmailAddress : email
IdentityRepository ..> EmailAddress : looks up by
IdentityService ..> EmailAddress : identifies account

@enduml
